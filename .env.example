# Documentation only. Do not commit a real .env file.
TDAI_USER_KEY=<YOUR_USER_KEY>
TDAI_MEMORY_ENDPOINT=https://memory.example.com:18420
# Optional root endpoint for Wiki/CodeGraph; required only by tdai_knowledge.
TDAI_KNOWLEDGE_ENDPOINT=https://knowledge.example.com:18424
TDAI_SERVICE_ID=default
TDAI_TEAM_ID=<YOUR_TEAM_ID>
TDAI_AGENT_ID=<YOUR_AGENT_ID>
TDAI_USER_ID=<YOUR_USER_ID>
# Used by Hermes/OpenCode/Pi adapters. Prefer absolute paths.
TDAI_MEMORY_SCRIPT=/absolute/path/to/useTDAI/scripts/server.py
TDAI_UV=/absolute/path/to/uv
# Optional; defaults to ~/.codex/tdai-memory on every platform.
# TDAI_LOCAL_DATA_DIR=/absolute/path/to/local/tdai-memory-state
# Optional. Leave unset unless this installation is dedicated to one TDAI Task.
# TDAI_TASK_ID=<YOUR_TASK_ID>
